# Postgres password used by docker-compose and DATABASE_URL.
# Set a strong value before deploying (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=junkie
DATABASE_URL=postgres://junkie:junkie@localhost:5432/junkie?sslmode=disable
ADDR=:8080
# Create/sign in this account before setting the bootstrap username.
JUNKIE_OWNER_USERNAME=
