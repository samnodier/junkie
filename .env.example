# Postgres password used by docker-compose's local postgres service
# (docker-compose.yml). Not used with docker-compose.neon.yml.
# Set a strong value before deploying (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=junkie
# Local dev / self-hosted postgres default. For docker-compose.neon.yml,
# replace this with your Neon connection string (includes sslmode=require).
DATABASE_URL=postgres://junkie:junkie@localhost:5432/junkie?sslmode=disable
ADDR=:8080
# Create/sign in this account before setting the bootstrap username.
JUNKIE_OWNER_USERNAME=
# Public hostname for the Caddy TLS proxy (prod profile only), e.g.
# yourname.duckdns.org — see DEPLOY.md.
DOMAIN=
